CC = gcc
CFLAGS = -Wall -Wextra -Werror -pedantic -Isrc

TARGET = app
TEST_TARGET = test_runner

# App entry point
SRCS_MAIN = main.c

# Core sources (used by main app and tests)
SRCS_CORE = src/compress.c src/debug.c

# GUI sources
SRCS_GUI = src/gui.c

# Test entry point
SRCS_TEST = tests/tests.c

# Generate object file lists
OBJS_MAIN = $(SRCS_MAIN:.c=.o)
OBJS_CORE = $(SRCS_CORE:.c=.o)
OBJS_GUI  = $(SRCS_GUI:.c=.o)
OBJS_TEST = $(SRCS_TEST:.c=.o)

# Header dependency files (generated by -MMD)
DEPS = $(OBJS_MAIN:.o=.d) $(OBJS_CORE:.o=.d) $(OBJS_GUI:.o=.d) $(OBJS_TEST:.o=.d)

# GTK3 flags (lazily evaluated: pkg-config only runs when a GUI rule needs it,
# so `make no-gui` works on machines without GTK installed).
# -I is turned into -isystem so that warnings coming from GTK/GLib headers
# don't trip -Werror.
GTK_CFLAGS = $(shell pkg-config --cflags gtk+-3.0 | sed 's/-I/-isystem /g')
GTK_LIBS   = $(shell pkg-config --libs gtk+-3.0)

all: $(TARGET)

# Standard build with GUI (requires libgtk-3-dev)
$(TARGET): $(OBJS_MAIN) $(OBJS_CORE) $(OBJS_GUI)
	$(CC) $(CFLAGS) -o $@ $^ $(GTK_LIBS)

# Only gui.c needs the GTK headers
$(OBJS_GUI): CFLAGS += $(GTK_CFLAGS) -Wno-deprecated-declarations

# No-GUI target (command line only, no GTK needed)
no-gui: CFLAGS += -DNO_GUI
no-gui: clean-obj $(OBJS_MAIN) $(OBJS_CORE)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS_MAIN) $(OBJS_CORE)

# Target-specific flag: Map tests() to main() in tests.c during preprocessing
$(OBJS_TEST): CFLAGS += -Dtests=main

# Run test suite (the tests never need the GUI)
tests: $(TEST_TARGET)
	@echo "Running tests..."
	./$(TEST_TARGET)

$(TEST_TARGET): $(OBJS_TEST) $(OBJS_CORE)
	$(CC) $(CFLAGS) -o $@ $^

# Compile C files to object files
%.o: %.c
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Clean object files
clean-obj:
	rm -f $(OBJS_MAIN) $(OBJS_CORE) $(OBJS_GUI) $(OBJS_TEST) $(DEPS)

# Clean everything
clean: clean-obj
	rm -f $(TARGET) $(TEST_TARGET)

-include $(DEPS)

.PHONY: all clean clean-obj no-gui tests
